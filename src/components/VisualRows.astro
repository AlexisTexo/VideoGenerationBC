---
import { VISUAL_LABELS, type VisualSlot } from '../lib/video-ai';
import { assetFor, type Asset } from '../lib/video-assets';
import { FORMATS, type FormatId } from '../lib/video-format';

interface Props {
  visuals: VisualSlot[];
  assets: Asset[];
  formats: FormatId[];
  /** Enlaces firmados de los archivos, por ruta. */
  urls: Map<string, string | null | undefined>;
  videoId: string;
  /** Muestra el ícono para rehacer en cada fila. */
  canRemake: boolean;
  /** Pantalla a la que volver después de rehacer. */
  returnTo: string;
}

const { visuals, assets, formats, urls, videoId, canRemake, returnTo } = Astro.props;

type Job = { index: number; format: FormatId | 'any' };
const jobs: Job[] = visuals.flatMap((slot, index): Job[] =>
  slot.type === 'pexels_clip' ? [{ index, format: 'any' }] : formats.map((format) => ({ index, format })),
);
const jobAsset = (job: Job) =>
  assetFor(assets, job.index, visuals[job.index], job.format === 'any' ? '9:16' : job.format);

const clock = (seconds: number) => `${Math.floor(seconds / 60)}:${String(Math.floor(seconds % 60)).padStart(2, '0')}`;

const redoLabel = (visual: VisualSlot, slotAssets: (Asset | null)[]) =>
  slotAssets.some((a) => a?.status !== 'done')
    ? 'Generar'
    : visual.type === 'pexels_clip'
      ? 'Buscar otro clip'
      : formats.length > 1
        ? 'Rehacer imágenes'
        : 'Rehacer imagen';
---

<ol class="divide-y divide-border rounded-2xl border border-border bg-surface">
  {
    visuals.map((visual, i) => {
      const slotJobs = jobs.filter((j) => j.index === i);
      const slotAssets = slotJobs.map(jobAsset);
      const label = redoLabel(visual, slotAssets);
      return (
        <li id={`visual-${i}`} class="relative grid scroll-mt-24 gap-3 px-5 py-4 sm:grid-cols-[6.5rem_1fr]">
          <p class="font-medium tabular-nums text-muted">
            {clock(visual.start)}–{clock(visual.end)}
          </p>
          <div class="min-w-0">
            <p class="pr-12 font-medium">{VISUAL_LABELS[visual.type]}</p>
            <p class="mt-1 pr-12 text-muted">{visual.prompt}</p>
            <div class="mt-3 flex flex-wrap gap-4">
              {slotJobs.map((job) => {
                const asset = jobAsset(job);
                const src = asset?.status === 'done' ? urls.get(asset.path) : undefined;
                const wide = job.format !== '9:16';
                return (
                  <div class="w-fit">
                    <div class:list={['overflow-hidden rounded-xl border border-border bg-bg', wide ? 'h-32 w-56' : 'h-56 w-32']}>
                      {src && asset?.mime.startsWith('video/') && (
                        <video
                          src={`${src}#t=0.1`}
                          muted
                          loop
                          playsinline
                          preload="metadata"
                          class="size-full cursor-pointer object-cover"
                          aria-label={`Vista previa: ${visual.prompt}`}
                          data-preview-video
                        />
                      )}
                      {src && asset?.mime.startsWith('image/') && (
                        <img src={src} alt={visual.prompt} loading="lazy" class="size-full object-cover" />
                      )}
                    </div>
                    {job.format !== 'any' && formats.length > 1 && (
                      <p class="mt-1 text-xs text-muted">{FORMATS[job.format].label}</p>
                    )}
                    {asset?.status === 'error' && <p class="mt-1 max-w-56 text-sm text-danger">{asset.error}</p>}
                    {!asset && <p class="mt-1 text-sm text-muted">Pendiente</p>}
                    {asset?.status === 'done' &&
                      asset.orientation &&
                      !formats.some((f) => (f === '9:16') === (asset.orientation === 'portrait')) && (
                        <p class="mt-1 max-w-56 text-xs text-muted">
                          Clip {asset.orientation === 'portrait' ? 'vertical' : 'horizontal'}: se recorta al formato al editar.
                        </p>
                      )}
                  </div>
                );
              })}
            </div>
          </div>
          {canRemake && (
            <form method="post" action="/api/videos/regenerate" class="absolute right-4 top-3" data-remake-form>
              <input type="hidden" name="video_id" value={videoId} />
              <input type="hidden" name="index" value={i} />
              <input type="hidden" name="format" value="all" />
              <input type="hidden" name="return_to" value={returnTo} />
              <button
                type="submit"
                aria-label={label}
                title={label}
                class="grid size-9 place-items-center rounded-lg border border-border bg-bg text-muted transition-[color,background-color,transform] duration-150 ease-out hover:bg-surface hover:text-text active:scale-[0.95] disabled:opacity-70"
                data-remake
              >
                <svg viewBox="0 0 24 24" class="size-4" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" data-remake-icon>
                  <path d="M21 12a9 9 0 1 1-3-6.7L21 8" />
                  <path d="M21 3v5h-5" />
                </svg>
              </button>
            </form>
          )}
        </li>
      );
    })
  }
</ol>

<script>
  // Clips: vista previa al pasar el cursor (con el dedo, un toque la inicia o la detiene).
  for (const video of document.querySelectorAll<HTMLVideoElement>('[data-preview-video]')) {
    const stop = () => {
      video.pause();
      video.currentTime = 0.1;
    };
    video.addEventListener('pointerenter', (event) => {
      if (event.pointerType === 'mouse') void video.play().catch(() => {});
    });
    video.addEventListener('pointerleave', (event) => {
      if (event.pointerType === 'mouse') stop();
    });
    video.addEventListener('click', () => {
      if (video.paused) void video.play().catch(() => {});
      else stop();
    });
  }

  // Rehacer: solo se bloquea y gira el ícono de esa fila.
  for (const form of document.querySelectorAll<HTMLFormElement>('[data-remake-form]')) {
    form.addEventListener('submit', () => {
      const button = form.querySelector<HTMLButtonElement>('[data-remake]');
      if (button) {
        button.disabled = true;
        button.setAttribute('aria-busy', 'true');
        button.querySelector('[data-remake-icon]')?.classList.add('animate-spin', 'motion-reduce:animate-none');
      }
    });
  }
</script>
