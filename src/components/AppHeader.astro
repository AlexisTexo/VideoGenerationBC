---
const { user, role } = Astro.locals;
---

<header class="border-b border-border">
  <div class="mx-auto flex h-14 max-w-5xl items-center justify-between px-4">
    <div class="flex items-center gap-5">
      <a href="/" class="text-sm font-semibold tracking-tight">VideoGeneratorBC</a>
      {
        role === 'admin' && (
          <a href="/admin/users" class="text-sm text-muted hover:text-text">
            Usuarios
          </a>
        )
      }
    </div>
    <div class="flex items-center gap-3">
      <span class="hidden text-sm text-muted sm:inline">{user?.email}</span>
      <form method="post" action="/api/auth/logout">
        <button
          type="submit"
          class="h-9 rounded-lg border border-border px-3 text-sm font-medium hover:bg-surface focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-accent"
        >
          Salir
        </button>
      </form>
    </div>
  </div>
</header>
