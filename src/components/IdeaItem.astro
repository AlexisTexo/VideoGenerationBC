---
import { IDEA_STATUS_LABELS, type IdeaStatus } from '../lib/video-ai';

interface Props {
  id?: string;
  title?: string;
  angle?: string;
  status?: IdeaStatus;
}

const { id = '', title = '', angle = '', status = 'suggested' } = Astro.props;

const action =
  'h-10 items-center rounded-lg border border-border bg-bg px-4 font-medium transition-[background-color,transform] duration-150 ease-out hover:bg-surface active:scale-[0.97]';
---

<li
  class="group rounded-xl border border-border bg-surface p-4 transition-colors data-[picked=true]:border-accent data-[selected=true]:border-accent"
  data-idea
  data-id={id}
  data-status={status}
>
  <div class="flex items-start gap-3">
    <label class="-m-2 hidden shrink-0 cursor-pointer p-2 group-data-[status=suggested]:block">
      <input
        type="checkbox"
        data-pick
        aria-label="Elegir para crear varios videos"
        class="block size-5 cursor-pointer accent-[var(--accent)] disabled:cursor-not-allowed disabled:opacity-40"
      />
    </label>
    <div class="min-w-0 flex-1">
  <p class="font-semibold" data-idea-title>{title}</p>
  <p class="mt-1 text-muted" data-idea-angle>{angle}</p>
  <p class="mt-1 hidden text-sm text-muted group-data-[status=discarded]:block group-data-[status=used]:block" data-idea-status>
    {IDEA_STATUS_LABELS[status]}
  </p>
  <div class="mt-3 flex flex-wrap gap-2">
    <button type="button" data-use-idea class={`inline-flex ${action}`}>
      <span class="group-data-[status=used]:hidden">Usar esta idea</span>
      <span class="hidden group-data-[status=used]:inline">Usar con otra variación</span>
    </button>
    <button
      type="button"
      data-discard-idea
      class={`hidden group-data-[status=suggested]:inline-flex ${action} text-muted hover:text-text`}
    >
      Descartar
    </button>
  </div>
    </div>
  </div>
</li>
