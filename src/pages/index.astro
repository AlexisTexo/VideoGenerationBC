---
import Base from '../layouts/Base.astro';
import AppHeader from '../components/AppHeader.astro';
import ProjectLogo from '../components/ProjectLogo.astro';

const { supabase, role } = Astro.locals;
const canEdit = role === 'admin' || role === 'editor';

const { data: projects, error } = await supabase
  .from('projects')
  .select('id, name, description, logo_url')
  .order('name', { ascending: true });
---

<Base title="Proyectos · VideoGeneratorBC">
  <AppHeader />

  <main class="mx-auto max-w-5xl px-4 py-10">
    <div class="rise flex flex-wrap items-end justify-between gap-4" style="--i: 0">
      <div>
        <h1 class="text-3xl font-semibold tracking-tight">Proyectos</h1>
        <p class="mt-2 text-muted">Elige un proyecto para crear un video. Con “Editar” ajustas su marca, contenido y conocimiento.</p>
      </div>
      {
        canEdit && (
          <a
            href="/projects/new"
            class="inline-flex h-12 items-center rounded-lg bg-accent px-6 font-semibold text-accent-fg transition-[background-color,transform] hover:bg-accent-hover active:scale-[0.98]"
          >
            Nuevo proyecto
          </a>
        )
      }
    </div>

    {error && <p role="alert" class="mt-8 text-danger">No se pudieron cargar los proyectos.</p>}

    {
      projects && projects.length === 0 && (
        <p class="rise mt-10 text-muted" style="--i: 1">
          Aún no hay proyectos.{canEdit ? ' Crea el primero con el botón de arriba.' : ''}
        </p>
      )
    }

    {
      projects && projects.length > 0 && (
        <ul class="mt-10 grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
          {projects.map((p) => (
            <li class="relative flex min-h-64 flex-col rounded-2xl border border-border bg-surface p-5 hover:border-focus sm:aspect-square">
              <ProjectLogo name={p.name} logoUrl={p.logo_url} class="size-14" />

              <h2 class="mt-4 truncate text-lg font-semibold tracking-tight">
                <a href={`/projects/${p.id}`} class="after:absolute after:inset-0 after:rounded-2xl">
                  {p.name}
                </a>
              </h2>
              {p.description && <p class="mt-1 line-clamp-3 text-muted">{p.description}</p>}

              {canEdit && (
                <div class="relative z-10 mt-auto flex justify-end gap-2">
                  <a
                    href={`/projects/${p.id}`}
                    class="grid size-11 place-items-center rounded-xl bg-accent text-accent-fg hover:bg-accent-hover"
                    aria-label={`Crear un video de ${p.name}`}
                    title="Crear video"
                  >
                    <svg viewBox="0 0 24 24" class="size-5" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                      <path d="m16 13 5.223 3.482a.5.5 0 0 0 .777-.416V7.87a.5.5 0 0 0-.752-.432L16 10.5"></path>
                      <rect x="2" y="6" width="14" height="12" rx="2"></rect>
                    </svg>
                  </a>
                  <a
                    href={`/projects/${p.id}/history`}
                    class="grid size-11 place-items-center rounded-xl border border-border bg-bg text-text hover:border-focus hover:bg-surface"
                    aria-label={`Historial de ${p.name}`}
                    title="Historial de generaciones"
                  >
                    <svg viewBox="0 0 24 24" class="size-5" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                      <path d="M3 12a9 9 0 1 0 3-6.7L3 8" />
                      <path d="M3 3v5h5" />
                      <path d="M12 7v5l3 2" />
                    </svg>
                  </a>
                  <a
                    href={`/projects/${p.id}/settings`}
                    class="grid size-11 place-items-center rounded-xl border border-border bg-bg text-text hover:border-focus hover:bg-surface"
                    aria-label={`Editar ${p.name}`}
                    title="Editar proyecto"
                  >
                    <svg viewBox="0 0 24 24" class="size-5" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                      <path d="M21.174 6.812a1 1 0 0 0-3.986-3.987L3.842 16.174a2 2 0 0 0-.5.83l-1.321 4.352a.5.5 0 0 0 .623.622l4.353-1.32a2 2 0 0 0 .83-.497z"></path>
                      <path d="m15 5 4 4"></path>
                    </svg>
                  </a>
                </div>
              )}
            </li>
          ))}
        </ul>
      )
    }
  </main>
</Base>
