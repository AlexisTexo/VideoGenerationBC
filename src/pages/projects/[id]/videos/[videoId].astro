---
import Base from '../../../../layouts/Base.astro';
import AppHeader from '../../../../components/AppHeader.astro';
import ProjectLogo from '../../../../components/ProjectLogo.astro';
import Stepper from '../../../../components/Stepper.astro';
import VoiceItem from '../../../../components/VoiceItem.astro';
import { isUuid } from '../../../../lib/projects';
import { VISUAL_LABELS, type Scene, type VisualSlot } from '../../../../lib/video-ai';
import { assetFor, normalizeAssets } from '../../../../lib/video-assets';
import { FORMAT_IDS, FORMATS, isFormatId, type FormatId } from '../../../../lib/video-format';
import { MUSIC_COLUMNS, type MusicTrack } from '../../../../lib/music';
import { loadPreferences, visualsFor } from '../../../../lib/preferences';
import { LIMITS, recommendedVisuals } from '../../../../lib/video-plan';
import { canCreate } from '../../../../lib/video-data';
import { VOICE_COLUMNS, type Voice } from '../../../../lib/voices';

const { supabase, role } = Astro.locals;
const canEdit = canCreate(role);

const { id, videoId } = Astro.params;
if (!id || !videoId || !isUuid(id) || !isUuid(videoId)) {
  return new Response('No encontrado', { status: 404 });
}

const { data: video, error } = await supabase
  .from('videos')
  .select(
    'id, title, idea, voice_id, voice_name, target_seconds, script, visuals, script_approved, audio_path, audio_seconds, generated_at, assets, formats, sfx, music_track_id, project:projects(id, name, logo_url)',
  )
  .eq('id', videoId)
  .eq('project_id', id)
  .maybeSingle();

if (error) {
  console.error('cargar video falló:', error.code, error.message);
  return new Response('No se pudo cargar el video. Revisa que las migraciones estén aplicadas.', { status: 500 });
}
if (!video) {
  return new Response('No encontrado', { status: 404 });
}

const { data: voiceRows, error: voicesError } = await supabase
  .from('voices')
  .select(VOICE_COLUMNS)
  .order('last_used_at', { ascending: false, nullsFirst: false })
  .order('name', { ascending: true });
const voices = (voiceRows ?? []) as Voice[];

const { data: signed } = video.audio_path
  ? await supabase.storage.from('video-assets').createSignedUrl(video.audio_path, 3600)
  : { data: null };
const audioUrl = signed?.signedUrl ?? '';

const assets = normalizeAssets(video.assets);
const formats = ((video.formats ?? ['9:16']) as unknown[]).filter(isFormatId) as FormatId[];

const { data: trackRows, error: musicError } = await supabase
  .from('music_tracks')
  .select(MUSIC_COLUMNS)
  .order('created_at', { ascending: false });
const tracks = (trackRows ?? []) as MusicTrack[];

// Un solo lote de enlaces firmados (privados, 1 h) para imágenes, clips y música.
const signPaths = [...assets.filter((a) => a.status === 'done').map((a) => a.path), ...tracks.map((t) => t.path)];
const { data: signedAssets } = signPaths.length
  ? await supabase.storage.from('video-assets').createSignedUrls(signPaths, 3600)
  : { data: [] };
const urlByPath = new Map((signedAssets ?? []).map((a) => [a.path ?? '', a.signedUrl]));

const project = video.project as unknown as { id: string; name: string; logo_url: string };
const scenes = video.script as Scene[];
const visuals = video.visuals as VisualSlot[];
const total = scenes.at(-1)?.end ?? 0;

const STEPS = [
  { id: 'guion', label: 'Guion' },
  { id: 'visuales', label: 'Visuales' },
  { id: 'voz', label: 'Voz' },
  { id: 'audio', label: 'Audio' },
  { id: 'contenidos', label: 'Contenidos' },
] as const;
const requested = Astro.url.searchParams.get('step');
const activeId = STEPS.some((s) => s.id === requested) ? requested : 'guion';

const okParam = Astro.url.searchParams.get('ok');
const okMessages: Record<string, string> = {
  '1': 'Cambios guardados.',
  saved: 'Guion guardado. Apruébalo para poder generar los contenidos.',
  approved: 'Guion aprobado.',
  voice: 'Voz elegida y guardada en tu biblioteca.',
  remade: 'Listo: elemento rehecho.',
  generated: 'Contenidos generados.',
  audio: 'Audio guardado.',
  music: 'Música guardada en tu biblioteca.',
  music_default: 'Música predeterminada: se elegirá sola en cada video nuevo.',
  music_default_off: 'Ya no hay música predeterminada.',
  music_deleted: 'Música quitada de la biblioteca.',
  partial:
    Astro.url.searchParams.get('failed') === '1'
      ? 'Contenidos generados, pero 1 no se pudo generar. Revisa la lista y pulsa “Completar contenidos” para reintentar.'
      : `Contenidos generados, pero ${Astro.url.searchParams.get('failed') ?? 'algunos'} no se pudieron generar. Revisa la lista y pulsa “Completar contenidos” para reintentar.`,
};
const problem = Astro.url.searchParams.get('error');
const errorMessages: Record<string, string> = {
  counts: `Elige al menos una imagen o un video, hasta ${LIMITS.maxVisuals} en total.`,
  ai: 'No se pudo planear los visuales. Intenta de nuevo.',
  config: 'Falta configurar GEMINI_API_KEY en el archivo .env del servidor.',
  save: 'No se pudieron guardar los cambios.',
  voice: 'Ese ID de voz no tiene un formato válido.',
  script: 'El guion no puede quedar vacío.',
  notready: 'Antes de generar: aprueba el guion, planea los visuales y elige la voz.',
  voice_config: 'Falta ELEVENLABS_API_KEY en el archivo .env del servidor.',
  voice_auth: 'ElevenLabs rechazó la clave. Revisa ELEVENLABS_API_KEY.',
  voice_not_found: 'ElevenLabs no encontró esa voz. Revisa el ID en el paso Voz.',
  voice_quota: 'Se acabaron los créditos de ElevenLabs o hay demasiadas solicitudes. Intenta más tarde.',
  voice_request: 'No se pudo generar la voz. Intenta de nuevo.',
  align: 'La voz se generó, pero no se pudieron ajustar los tiempos.',
  upload: 'No se pudo guardar el audio. Revisa que la migración 0009 esté aplicada.',
  remake: 'No se pudo rehacer: ese elemento ya no está en el plan de visuales.',
  remake_failed: `No se pudo rehacer${Astro.url.searchParams.get('detail') ? `: ${Astro.url.searchParams.get('detail')}` : ''}. Se conservó el anterior si existía.`,
  formats: 'Elige al menos un formato: vertical 9:16 u horizontal 16:9.',
  music_file: 'El archivo debe ser un audio válido (MP3, WAV, M4A u OGG).',
  music_size: 'La música pesa demasiado: máximo 15 MB.',
  music_save: 'No se pudo guardar la música. Revisa que la migración 0011 esté aplicada.',
  music_prompt: 'Describe la música que quieres (mínimo 5 caracteres).',
  music_config: 'Falta ELEVENLABS_API_KEY en el archivo .env del servidor.',
  music_auth: 'ElevenLabs rechazó la clave. Revisa ELEVENLABS_API_KEY.',
  music_quota: 'Se acabaron los créditos de ElevenLabs o hay demasiadas solicitudes.',
  music_invalid: 'ElevenLabs rechazó la descripción de la música. Prueba con otra.',
  music_request: 'No se pudo generar la música. Intenta de nuevo.',
};

// Sin visuales aún: se propone la cantidad recomendada con la proporción de imágenes que esta persona suele usar.
const { prefs, saved: hasPrefs } = await loadPreferences(supabase, Astro.locals.user?.id);
const recommended = hasPrefs
  ? visualsFor(Math.round(total) || video.target_seconds, prefs.image_share)
  : recommendedVisuals(Math.round(total) || video.target_seconds);
const imageCount = visuals.filter((v) => v.type === 'gemini_image').length;
const clipCount = visuals.filter((v) => v.type === 'pexels_clip').length;

const done: Record<string, boolean> = {
  guion: video.script_approved,
  visuales: visuals.length > 0,
  voz: Boolean(video.voice_id),
  audio: Boolean(video.music_track_id) || video.sfx,
  contenidos: Boolean(video.generated_at),
};
const ready = done.guion && done.visuales && done.voz;
const generated = Boolean(video.generated_at);
const remakeLabel = (type: string, asset: { status: string } | null) =>
  !asset || asset.status === 'error' ? 'Generar' : type === 'pexels_clip' ? 'Buscar otro clip' : formats.length > 1 ? 'Rehacer imágenes' : 'Rehacer imagen';
// Lo que debe existir: una imagen por formato y un clip por visual de video.
type Job = { index: number; format: FormatId | 'any' };
const jobs: Job[] = visuals.flatMap((slot, index): Job[] =>
  slot.type === 'pexels_clip' ? [{ index, format: 'any' }] : formats.map((format) => ({ index, format })),
);
const jobAsset = (job: Job) =>
  assetFor(assets, job.index, visuals[job.index], job.format === 'any' ? '9:16' : job.format);
const failedCount = jobs.filter((j) => jobAsset(j)?.status === 'error').length;
const missingCount = jobs.filter((j) => !jobAsset(j)).length;
const incomplete = generated && (failedCount > 0 || missingCount > 0);

const clock = (seconds: number) => {
  const m = Math.floor(seconds / 60);
  const s = Math.floor(seconds % 60);
  return `${m}:${String(s).padStart(2, '0')}`;
};

const buttonBase =
  'inline-flex h-12 shrink-0 items-center justify-center gap-2 rounded-xl px-5 text-base font-semibold transition-[background-color,transform] duration-150 ease-out active:scale-[0.97] disabled:opacity-50 disabled:active:scale-100';
const secondary = `${buttonBase} border border-border bg-surface hover:bg-bg`;
const primary = `${buttonBase} bg-accent text-accent-fg hover:bg-accent-hover`;
const field =
  'h-12 w-full rounded-xl border border-border bg-surface px-4 text-base focus-visible:border-focus disabled:opacity-60';
---

<Base title={`${video.title || 'Guion'} · ${project.name}`}>
  <AppHeader />

  <main class="mx-auto max-w-3xl px-4 py-8" data-video>
    <a href={`/projects/${project.id}`} class="text-muted transition-colors hover:text-text">← Nuevo video</a>

    <div class="mt-4 flex items-center gap-4">
      <ProjectLogo name={project.name} logoUrl={project.logo_url} class="size-12" />
      <div class="min-w-0">
        <h1 class="text-2xl font-semibold tracking-tight">{video.title || 'Guion sin título'}</h1>
        <p class="text-muted">{project.name}</p>
      </div>
    </div>

    <div class="mt-8 rounded-2xl border border-border bg-surface p-5">
      <div class="flex flex-wrap items-center justify-between gap-4">
        <ul class="flex flex-wrap gap-x-6 gap-y-2" aria-label="Qué falta para generar">
          {
            [
              { id: 'guion', label: 'Guion aprobado' },
              { id: 'visuales', label: 'Visuales' },
              { id: 'voz', label: 'Voz' },
            ].map((item) => (
              <li class="flex items-center gap-2">
                {done[item.id] ? (
                  <svg viewBox="0 0 24 24" class="size-5 text-ok" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" role="img" aria-label="Listo">
                    <path d="M20 6 9 17l-5-5" />
                  </svg>
                ) : (
                  <span class="size-5 rounded-full border-2 border-border" role="img" aria-label="Pendiente" />
                )}
                <span class:list={[done[item.id] ? 'font-medium' : 'text-muted']}>{item.label}</span>
              </li>
            ))
          }
        </ul>
        {
          canEdit && ready && (!generated || incomplete) && (
            <form method="post" action="/api/videos/generate" data-generate-form>
              <input type="hidden" name="video_id" value={video.id} />
              <button type="submit" class={primary} data-generate>
                {generated ? 'Completar contenidos' : 'Generar contenidos'}
              </button>
            </form>
          )
        }
        {
          ready && generated && !incomplete && (
            <p class="flex items-center gap-2 font-medium">
              <svg viewBox="0 0 24 24" class="size-5 text-ok" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <path d="M20 6 9 17l-5-5" />
              </svg>
              Contenidos listos
            </p>
          )
        }
      </div>
      {
        !ready && (
          <p class="mt-3 text-sm text-muted">
            Aprueba el guion, planea los visuales y elige la voz. Cuando los tres tengan palomita verde aparece el botón
            para generar los contenidos.
          </p>
        )
      }
    </div>

    <div role="tablist" aria-label="Pasos del video" class="mt-8 flex gap-1 border-b border-border" data-tablist>
      {
        STEPS.map((step) => (
          <button
            type="button"
            role="tab"
            id={`tab-${step.id}`}
            aria-controls={`panel-${step.id}`}
            aria-selected={step.id === activeId ? 'true' : 'false'}
            tabindex={step.id === activeId ? 0 : -1}
            data-tab={step.id}
            class="-mb-px inline-flex h-12 items-center gap-2 border-b-2 border-transparent px-4 font-medium text-muted transition-colors hover:text-text aria-selected:border-accent aria-selected:text-text"
          >
            {step.label}
            {done[step.id] && (
              <svg viewBox="0 0 24 24" class="size-4 text-ok" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" role="img" aria-label="Listo">
                <path d="M20 6 9 17l-5-5" />
              </svg>
            )}
          </button>
        ))
      }
    </div>

    <div class="mt-8">
      {okParam && okMessages[okParam] && <p role="status" data-flash class="mb-6 text-ok">{okMessages[okParam]}</p>}
      {
        problem && (
          <p role="alert" data-flash class="mb-6 text-danger">
            {errorMessages[problem] ?? 'Algo salió mal.'}
          </p>
        )
      }

      <section role="tabpanel" id="panel-guion" aria-labelledby="tab-guion" data-panel="guion" hidden={activeId !== 'guion'}>
        <h2 class="text-2xl font-semibold tracking-tight">Guion</h2>
        <dl class="mt-4 grid gap-x-8 gap-y-3 sm:grid-cols-[auto_1fr]">
          <dt class="font-medium">Idea</dt>
          <dd class="text-muted">{video.idea}</dd>
          <dt class="font-medium">Duración</dt>
          <dd class="text-muted">
            {clock(total)} de {video.target_seconds} s objetivo · {scenes.length} escenas
          </dd>
        </dl>
        <p class="mt-6 max-w-prose text-muted">
          Edita el texto de cualquier escena. Borra todo el texto de una escena para quitarla. Los tiempos se ajustan
          con la duración real de la voz al generar los contenidos.
        </p>

        <form method="post" action="/api/videos/script" class="mt-4" data-script-form>
          <input type="hidden" name="video_id" value={video.id} />
          <fieldset disabled={!canEdit}>
            <ol class="divide-y divide-border rounded-2xl border border-border bg-surface">
              {
                scenes.map((scene, index) => (
                  <li class="grid gap-3 px-5 py-4 sm:grid-cols-[6.5rem_1fr]">
                    <p class="pt-2 font-medium tabular-nums text-muted">{clock(scene.start)}–{clock(scene.end)}</p>
                    <div>
                      <label class="sr-only" for={`scene-${index}`}>Texto de la escena {index + 1}</label>
                      <textarea
                        id={`scene-${index}`}
                        name="narration"
                        rows="2"
                        maxlength="1000"
                        class="w-full resize-none overflow-hidden rounded-lg border border-transparent bg-transparent p-2 leading-relaxed hover:border-border focus-visible:border-focus disabled:opacity-100"
                        data-narration={scene.narration}>{scene.narration}</textarea>
                    </div>
                  </li>
                ))
              }
            </ol>
          </fieldset>

          {
            canEdit && (
              <div class="mt-6 flex flex-wrap items-center gap-3">
                <button type="submit" name="action" value="approve" class={primary}>
                  {video.script_approved ? 'Guion aprobado' : 'Aprobar guion'}
                </button>
                <button type="submit" name="action" value="save" class={secondary}>Guardar cambios</button>
                <p class="text-sm text-muted" data-script-hint aria-live="polite">
                  {video.script_approved ? 'Si lo editas, tendrás que aprobarlo otra vez.' : 'Revísalo y apruébalo para seguir.'}
                </p>
              </div>
            )
          }
        </form>

        <div class="mt-10 flex justify-end">
          <button type="button" class={secondary} data-goto="visuales">Siguiente: visuales →</button>
        </div>
      </section>

      <section role="tabpanel" id="panel-visuales" aria-labelledby="tab-visuales" data-panel="visuales" hidden={activeId !== 'visuales'}>
        <h2 class="text-2xl font-semibold tracking-tight">Imágenes y videos</h2>
        <p class="mt-2 max-w-prose text-muted">
          Elige cuántas imágenes generadas con Gemini y cuántos videos de stock de Pexels aparecen. Pon 0 en lo que no
          quieras. Se reparten a lo largo del guion.
        </p>

        <form method="post" action="/api/videos/visuals" class="mt-6" data-visuals-form>
          <input type="hidden" name="video_id" value={video.id} />
          <fieldset disabled={!canEdit}>
            <div class="grid gap-6 sm:grid-cols-2">
              <Stepper
                name="images"
                label="Imágenes con IA"
                hint="Las genera Gemini con la paleta del proyecto."
                value={imageCount || recommended.images}
                min={0}
                max={LIMITS.maxVisuals}
              />
              <Stepper
                name="clips"
                label="Videos de Pexels"
                hint="Clips de stock que se buscan por escena."
                value={visuals.length ? clipCount : recommended.clips}
                min={0}
                max={LIMITS.maxVisuals}
              />
            </div>
            <fieldset class="mt-8">
              <legend class="font-medium">Formato del video</legend>
              <p class="mt-1 max-w-prose text-sm text-muted">
                Elige uno o los dos. Se genera una imagen por formato y los subtítulos se acomodan dentro de la zona
                segura de cada uno (lo que la plataforma no tapa).
              </p>
              <div class="mt-3 grid gap-3 sm:grid-cols-2">
                {
                  FORMAT_IDS.map((id) => {
                    const f = FORMATS[id];
                    const pct = (n: number, of: number) => `${(n / of) * 100}%`;
                    const { safe, box } = f.subtitles;
                    return (
                      <label class="cursor-pointer">
                        <input type="checkbox" name="formats" value={id} checked={formats.includes(id)} class="peer sr-only" data-format />
                        <span class="flex items-center gap-4 rounded-xl border border-border bg-surface p-4 transition-colors peer-checked:border-accent peer-focus-visible:outline-2 peer-focus-visible:outline-offset-2 peer-focus-visible:outline-focus">
                          <span
                            class="relative block shrink-0 rounded-md border border-border bg-bg"
                            style={id === '9:16' ? 'width:36px;height:64px' : 'width:64px;height:36px'}
                            aria-hidden="true"
                          >
                            <span
                              class="absolute rounded-sm border border-dashed border-muted/70"
                              style={`left:${pct(safe.left, f.width)};right:${pct(safe.right, f.width)};top:${pct(safe.top, f.height)};bottom:${pct(safe.bottom, f.height)}`}
                            />
                            <span
                              class="absolute rounded-sm bg-accent"
                              style={`left:${pct(box.x, f.width)};width:${pct(box.width, f.width)};top:${pct(box.y + box.height * 0.45, f.height)};height:${pct(box.height * 0.5, f.height)}`}
                            />
                          </span>
                          <span class="min-w-0">
                            <span class="block font-semibold">{f.label}</span>
                            <span class="block text-sm text-muted">{f.platforms}</span>
                            <span class="block text-sm text-muted">Subtítulos de hasta {f.subtitles.maxCharsPerLine} letras por línea</span>
                          </span>
                        </span>
                      </label>
                    );
                  })
                }
              </div>
            </fieldset>
            <div class="mt-6 rounded-xl border border-border bg-surface p-4">
              <p class="text-lg font-semibold" data-visuals-total aria-live="polite"></p>
              <dl class="mt-3 grid grid-cols-2 divide-x divide-border">
                <div class="pr-4">
                  <dt class="text-sm text-muted">Imágenes</dt>
                  <dd class="text-2xl font-semibold tabular-nums" data-count-images>0</dd>
                </div>
                <div class="pl-4">
                  <dt class="text-sm text-muted">Videos</dt>
                  <dd class="text-2xl font-semibold tabular-nums" data-count-clips>0</dd>
                </div>
              </dl>
              <button
                type="button"
                data-use-recommended
                data-images={recommended.images}
                data-clips={recommended.clips}
                class="mt-4 text-sm italic text-text no-underline transition-opacity duration-150 ease-out hover:opacity-70"
              >
                Usar lo recomendado ({recommended.images} imágenes y {recommended.clips} videos)
              </button>
            </div>
          </fieldset>
          {
            canEdit && (
              <div class="mt-6 flex flex-wrap items-center gap-3">
                <button type="submit" class={primary} data-visuals-submit>
                  {visuals.length ? 'Volver a planear visuales' : 'Planear visuales'}
                </button>
                <p class="text-sm text-muted">La IA decide qué mostrar en cada momento. Puede tardar un poco.</p>
              </div>
            )
          }
        </form>

        {
          visuals.length > 0 && (
            <>
              <h3 class="mt-12 font-semibold">Plan de visuales</h3>
              <ol class="mt-3 divide-y divide-border rounded-2xl border border-border bg-surface">
                {visuals.map((v) => (
                  <li class="grid gap-3 px-5 py-4 sm:grid-cols-[6.5rem_1fr]">
                    <p class="font-medium tabular-nums text-muted">
                      {clock(v.start)}–{clock(v.end)}
                    </p>
                    <div class="min-w-0">
                      <p class="font-medium">{VISUAL_LABELS[v.type]}</p>
                      <p class="mt-1 text-muted">{v.prompt}</p>
                    </div>
                  </li>
                ))}
              </ol>
            </>
          )
        }

        <div class="mt-10 flex justify-between">
          <button type="button" class={secondary} data-goto="guion">← Guion</button>
          <button type="button" class={secondary} data-goto="voz">Siguiente: voz →</button>
        </div>
      </section>

      <section role="tabpanel" id="panel-voz" aria-labelledby="tab-voz" data-panel="voz" hidden={activeId !== 'voz'}>
        <h2 class="text-2xl font-semibold tracking-tight">Elige la voz</h2>
        <p class="mt-2 max-w-prose text-muted">
          Pega el ID de una voz de ElevenLabs y escúchala. Las voces que uses en un video se guardan solas en tu
          biblioteca; también puedes guardar una sin usarla.
        </p>

        <form method="post" action="/api/videos/voice" class="mt-6" data-voice-form>
          <input type="hidden" name="video_id" value={video.id} />
          <input type="hidden" name="voice_name" value={video.voice_name} data-voice-name />
          <fieldset disabled={!canEdit}>
            <div class="flex gap-3">
              <label class="sr-only" for="voice_id">ID de voz (ElevenLabs)</label>
              <input
                id="voice_id"
                name="voice_id"
                maxlength="40"
                autocomplete="off"
                spellcheck="false"
                placeholder="ID de voz"
                value={video.voice_id}
                class={field}
                data-voice-id
              />
              <button type="button" class={secondary} data-voice-preview>Escuchar</button>
            </div>
            <p class="mt-3 text-muted" data-voice-status aria-live="polite">
              {video.voice_name ? `Voz de este video: ${video.voice_name}` : ''}
            </p>

            <div class="mt-4 rounded-2xl border border-border bg-surface p-4" hidden data-voice-card>
              <div class="flex items-center gap-4">
                <button
                  type="button"
                  data-voice-play
                  aria-label="Reproducir o pausar la muestra"
                  class="group grid size-12 shrink-0 place-items-center rounded-full bg-accent text-accent-fg transition-[background-color,transform] duration-150 ease-out hover:bg-accent-hover active:scale-[0.97]"
                >
                  <svg viewBox="0 0 24 24" class="size-5 group-data-[playing=true]:hidden" fill="currentColor" aria-hidden="true">
                    <path d="M8 5.5v13a1 1 0 0 0 1.5.86l10-6.5a1 1 0 0 0 0-1.72l-10-6.5A1 1 0 0 0 8 5.5Z" />
                  </svg>
                  <svg viewBox="0 0 24 24" class="hidden size-5 group-data-[playing=true]:block" fill="currentColor" aria-hidden="true">
                    <rect x="6" y="5" width="4" height="14" rx="1" />
                    <rect x="14" y="5" width="4" height="14" rx="1" />
                  </svg>
                </button>
                <div class="min-w-0 flex-1">
                  <p class="truncate font-semibold" data-voice-title></p>
                  <div class="mt-2 h-1.5 overflow-hidden rounded-full bg-border" aria-hidden="true">
                    <div class="h-full origin-left bg-accent" style="transform: scaleX(0)" data-voice-progress></div>
                  </div>
                </div>
              </div>
              <div class="mt-4 flex flex-wrap items-center gap-3">
                <button type="button" class={secondary} data-voice-save>Guardar en mi biblioteca</button>
                <p class="text-sm text-muted" data-save-status aria-live="polite"></p>
              </div>
            </div>
            <audio hidden data-voice-audio></audio>
          </fieldset>

          {
            canEdit && (
              <div class="mt-6 flex flex-wrap items-center gap-3">
                <button type="submit" class={primary}>Usar esta voz en el video</button>
                <p class="text-sm text-muted">Dejar el ID vacío quita la voz del video.</p>
              </div>
            )
          }
        </form>

        <div class="mt-12 border-t border-border pt-8">
          <h3 class="text-xl font-semibold tracking-tight">
            Mis voces <span class="font-normal text-muted tabular-nums" data-voices-count>({voices.length})</span>
          </h3>
          {voicesError && <p class="mt-2 text-danger">Falta la migración 0008 para la biblioteca de voces.</p>}
          <ul class="mt-4 space-y-3" data-voices>
            {voices.map((v, i) => <VoiceItem voice={v} latest={i === 0 && Boolean(v.last_used_at)} />)}
          </ul>
          <p class="mt-2 text-muted" data-voices-empty hidden={voices.length > 0}>
            Aún no guardas voces. Escucha una y pulsa “Guardar en mi biblioteca”.
          </p>
        </div>

        <div class="mt-10 flex">
          <button type="button" class={secondary} data-goto="visuales">← Visuales</button>
        </div>
      </section>

      <section role="tabpanel" id="panel-audio" aria-labelledby="tab-audio" data-panel="audio" hidden={activeId !== 'audio'}>
        <h2 class="text-2xl font-semibold tracking-tight">Música y efectos</h2>
        <p class="mt-2 max-w-prose text-muted">
          Es opcional. Las pistas se guardan en tu biblioteca para usarlas en otros videos; la que marques como
          predeterminada se elige sola en cada video nuevo.
        </p>
        {musicError && <p class="mt-3 text-danger">Falta la migración 0011 para la música y los formatos.</p>}

        <form id="music-form" method="post" action="/api/music" data-music-form>
          <input type="hidden" name="video_id" value={video.id} />
        </form>

        <form method="post" action="/api/videos/audio" class="mt-6" data-audio-form>
          <input type="hidden" name="video_id" value={video.id} />
          <fieldset disabled={!canEdit}>
            <label class="flex cursor-pointer items-center gap-3 font-medium">
              <input type="checkbox" name="sfx" checked={video.sfx} class="size-5 accent-accent" />
