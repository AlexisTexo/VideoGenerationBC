      <section role="tabpanel" id="panel-contenidos" aria-labelledby="tab-contenidos" data-panel="contenidos" hidden={activeId !== 'contenidos'}>
        <h2 class="text-2xl font-semibold tracking-tight">Contenidos</h2>
        {
          generated ? (
            <>
              <p class="mt-2 max-w-prose text-muted">
                La voz dura {video.audio_seconds} segundos y el guion y los visuales ya usan esos tiempos.
              </p>

              <h3 class="mt-8 font-semibold">Voz</h3>
              {audioUrl ? (
                <audio controls src={audioUrl} class="mt-3 w-full" />
              ) : (
                <p class="mt-3 text-muted">No se pudo cargar el audio. Recarga la página.</p>
              )}

              <h3 class="mt-8 font-semibold">
                Imágenes y videos <span class="font-normal text-muted tabular-nums">({jobs.length - failedCount - missingCount} de {jobs.length})</span>
              </h3>
              <ol class="mt-3 divide-y divide-border rounded-2xl border border-border bg-surface">
                {visuals.map((visual, i) => {
                  const slotJobs = jobs.filter((j) => j.index === i);
                  const slotAssets = slotJobs.map((j) => jobAsset(j));
                  const redoLabel = remakeLabel(
                    visual.type,
                    slotAssets.every((a) => a?.status === 'done') ? { status: 'done' } : null,
                  );
                  return (
                    <li id={`visual-${i}`} class="relative grid scroll-mt-24 gap-3 px-5 py-4 sm:grid-cols-[6.5rem_1fr]">
                      <p class="font-medium tabular-nums text-muted">
                        {clock(visual.start)}–{clock(visual.end)}
                      </p>
                      <div class="min-w-0">
                        <p class="pr-12 font-medium">{VISUAL_LABELS[visual.type]}</p>
                        <p class="mt-1 pr-12 text-muted">{visual.prompt}</p>
                        <div class="mt-3 flex flex-wrap gap-4">
                          {slotJobs.map((job) => {
                            const asset = jobAsset(job);
                            const src = asset?.status === 'done' ? urlByPath.get(asset.path) : undefined;
                            const wide = job.format !== '9:16';
                            return (
                              <div class="w-fit">
                                <div class:list={['overflow-hidden rounded-xl border border-border bg-bg', wide ? 'h-32 w-56' : 'h-56 w-32']}>
                                  {src && asset?.mime.startsWith('video/') && (
                                    <video
                                      src={`${src}#t=0.1`}
                                      muted
                                      loop
                                      playsinline
                                      preload="metadata"
                                      class="size-full cursor-pointer object-cover"
                                      aria-label={`Vista previa: ${visual.prompt}`}
                                      data-preview-video
                                    />
                                  )}
                                  {src && asset?.mime.startsWith('image/') && (
                                    <img src={src} alt={visual.prompt} loading="lazy" class="size-full object-cover" />
                                  )}
                                </div>
                                {job.format !== 'any' && formats.length > 1 && (
                                  <p class="mt-1 text-xs text-muted">{FORMATS[job.format].label}</p>
                                )}
                                {asset?.status === 'error' && <p class="mt-1 max-w-56 text-sm text-danger">{asset.error}</p>}
                                {!asset && <p class="mt-1 text-sm text-muted">Pendiente</p>}
                                {asset?.status === 'done' && asset.orientation && !formats.some((f) => (f === '9:16') === (asset.orientation === 'portrait')) && (
                                  <p class="mt-1 max-w-56 text-xs text-muted">
                                    Clip {asset.orientation === 'portrait' ? 'vertical' : 'horizontal'}: se recorta al formato al editar.
                                  </p>
                                )}
                              </div>
                            );
                          })}
                        </div>
                      </div>
                      {canEdit && (
                        <form method="post" action="/api/videos/regenerate" class="absolute right-4 top-3" data-remake-form>
                          <input type="hidden" name="video_id" value={video.id} />
                          <input type="hidden" name="index" value={i} />
                          <input type="hidden" name="format" value="all" />
                          <button
                            type="submit"
                            aria-label={redoLabel}
                            title={redoLabel}
                            class="grid size-9 place-items-center rounded-lg border border-border bg-bg text-muted transition-[color,background-color,transform] duration-150 ease-out hover:bg-surface hover:text-text active:scale-[0.95] disabled:opacity-70"
                            data-remake
                          >
                            <svg viewBox="0 0 24 24" class="size-4" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" data-remake-icon>
                              <path d="M21 12a9 9 0 1 1-3-6.7L21 8" />
                              <path d="M21 3v5h-5" />
                            </svg>
                          </button>
                        </form>
                      )}
                    </li>
                  );
                })}
              </ol>

              <h3 class="mt-8 font-semibold">Formato y audio</h3>
              <ul class="mt-2 space-y-1 text-muted">
                <li>Formatos: {formats.map((f) => FORMATS[f].label).join(' y ')}.</li>
                <li>Música: {tracks.find((t) => t.id === video.music_track_id)?.name ?? 'sin música'}.</li>
                <li>Efectos de sonido: {video.sfx ? 'sí, se añaden al editar' : 'no'}.</li>
              </ul>

              <h3 class="mt-8 font-semibold">Paquete para editar</h3>
              <p class="mt-1 max-w-prose text-muted">
                Un ZIP con la voz, la música, las imágenes de cada formato, los clips, el guion con tiempos, los
                subtítulos ya acomodados y las instrucciones. Ábrelo en Claude para editar con Hyperframes o Remotion.
              </p>
              <div class="mt-3 flex flex-wrap items-center gap-3">
                <a class={primary} href={`/api/videos/zip?video_id=${video.id}`} download>
                  Descargar paquete (ZIP)
                </a>
                <a class="text-muted underline underline-offset-4 hover:text-text" href={`/api/videos/package?video_id=${video.id}&file=timeline.json`} download="timeline.json">
                  timeline.json
                </a>
                <a class="text-muted underline underline-offset-4 hover:text-text" href={`/api/videos/package?video_id=${video.id}&file=brief.md`} download="brief.md">
                  brief.md
                </a>
              </div>

              {canEdit && ready && (
                <form method="post" action="/api/videos/generate" class="mt-10 border-t border-border pt-6" data-generate-form>
                  <input type="hidden" name="video_id" value={video.id} />
                  <input type="hidden" name="force" value="1" />
