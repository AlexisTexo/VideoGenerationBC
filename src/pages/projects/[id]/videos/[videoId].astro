            </label>
            <p class="mt-1 text-sm text-muted">
              Sonidos discretos en las transiciones y los momentos clave. Se agregan al editar el video.
            </p>

            <h3 class="mt-8 font-semibold">Música de fondo</h3>
            <ul class="mt-3 space-y-3">
              <li>
                <label class="flex cursor-pointer items-center gap-3 rounded-xl border border-border bg-surface p-3 has-[:checked]:border-accent">
                  <input type="radio" name="music_track_id" value="" checked={!video.music_track_id} class="size-5 accent-accent" />
                  <span class="font-medium">Sin música</span>
                </label>
              </li>
              {
                tracks.map((track) => (
                  <li class="flex flex-wrap items-center gap-3 rounded-xl border border-border bg-surface p-3 has-[:checked]:border-accent">
                    <input
                      type="radio"
                      name="music_track_id"
