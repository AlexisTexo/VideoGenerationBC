---
import Base from '../../../layouts/Base.astro';
import AppHeader from '../../../components/AppHeader.astro';
import ProjectLogo from '../../../components/ProjectLogo.astro';
import IdeaItem from '../../../components/IdeaItem.astro';
import Stepper from '../../../components/Stepper.astro';
import { PROJECT_COLUMNS, isUuid, type Project } from '../../../lib/projects';
import { BULK_LIMITS, LIMITS, PRESET_SECONDS } from '../../../lib/video-plan';
import { loadPreferences } from '../../../lib/preferences';
import { canCreate, loadIdeas } from '../../../lib/video-data';

const { supabase, role } = Astro.locals;
const canEdit = canCreate(role);

const { id } = Astro.params;
if (!id || !isUuid(id)) {
  return new Response('No encontrado', { status: 404 });
}

const { data, error: loadError } = await supabase.from('projects').select(PROJECT_COLUMNS).eq('id', id).maybeSingle();
if (loadError) {
  console.error('cargar proyecto falló:', loadError.code, loadError.message);
  return new Response('No se pudo cargar el proyecto. Revisa que las migraciones estén aplicadas.', { status: 500 });
}
const project = data as unknown as Project | null;
if (!project) {
  return new Response('No encontrado', { status: 404 });
}

const ideas = await loadIdeas(supabase, id);
const suggested = ideas.filter((i) => i.status === 'suggested');
const history = ideas.filter((i) => i.status !== 'suggested');

const { data: videoRows, error: videosError } = await supabase
  .from('videos')
  .select('id, title, script_approved, generated_at, parent_video_id, created_at')
  .eq('project_id', id)
  .order('created_at', { ascending: false })
  .limit(80);
const needsMigration = Boolean(videosError);
const videos = (videoRows ?? []) as {
  id: string;
  title: string;
  script_approved: boolean;
  generated_at: string | null;
  parent_video_id: string | null;
  created_at: string;
}[];
const startTab = Astro.url.searchParams.get('tab') === 'videos' ? 'videos' : 'suggested';
const param = (name: string) => Astro.url.searchParams.get(name) ?? '';
const bulkOk =
  param('ok') === 'bulk'
    ? `Listo: ${param('n')} ${param('n') === '1' ? 'video creado' : 'videos creados'} como borrador.${
        param('failed') ? ` ${param('failed')} ${param('failed') === '1' ? 'idea no se pudo escribir' : 'ideas no se pudieron escribir'}: siguen en Sugeridas.` : ''
      }${param('unplanned') ? ' Alguno quedó sin plan de visuales: arma el suyo en su pestaña Visuales.' : ''} Abre cada uno para aprobar su guion.`
    : '';

const error = Astro.url.searchParams.get('error');
const errorMessages: Record<string, string> = {
  idea: 'Escribe tu idea (mínimo 5 caracteres) o pide ideas con “Dame ideas”.',
  ai: 'No se pudo escribir el guion. Intenta de nuevo.',
  config: 'Falta configurar GEMINI_API_KEY en el archivo .env del servidor.',
  save: 'El guion se escribió, pero no se pudo guardar el video.',
  plan: `La duración debe estar entre ${LIMITS.minSeconds} y ${LIMITS.maxSeconds} segundos.`,
  bulk_pick: 'Elige al menos una idea sugerida.',
  bulk_limit: `Máximo ${BULK_LIMITS.ideas} ideas, ${BULK_LIMITS.perIdea} videos por idea y ${BULK_LIMITS.total} videos en total.`,
  bulk_ai: 'No se pudo escribir ningún guion. Intenta de nuevo en un momento.',
  bulk_save: 'Los guiones se escribieron, pero no se pudieron guardar los videos.',
};

// Arranca con la última duración que usó esta persona.
const { prefs, saved: hasPrefs } = await loadPreferences(supabase, Astro.locals.user?.id);
const DEFAULT_SECONDS = Math.min(LIMITS.maxSeconds, Math.max(LIMITS.minSeconds, prefs.seconds));
const prefsReset = Astro.url.searchParams.get('ok') === 'prefs';

const buttonBase =
  'inline-flex h-12 shrink-0 items-center justify-center gap-2 rounded-xl px-5 text-base font-semibold transition-[background-color,transform] duration-150 ease-out active:scale-[0.97] disabled:opacity-50 disabled:active:scale-100';
const secondary = `${buttonBase} border border-border bg-surface hover:bg-bg`;
const primary = `${buttonBase} bg-accent text-accent-fg hover:bg-accent-hover`;
---

<Base title={`Nuevo video · ${project.name}`}>
  <AppHeader />

  <main class="mx-auto max-w-5xl px-4 py-8" data-studio data-project-id={project.id}>
    <a href="/" class="text-muted transition-colors hover:text-text">← Proyectos</a>

    <div class="mt-4 flex flex-wrap items-center justify-between gap-4">
      <div class="flex items-center gap-4">
        <ProjectLogo name={project.name} logoUrl={project.logo_url} class="size-12" />
        <div>
          <h1 class="text-2xl font-semibold tracking-tight">Nuevo video</h1>
          <p class="text-muted">{project.name}</p>
        </div>
      </div>
      {
        canEdit && (
          <a
            href={`/projects/${project.id}/settings`}
            class="inline-flex h-10 items-center rounded-lg border border-border bg-surface px-4 font-medium transition-colors hover:bg-bg"
          >
            Editar proyecto
          </a>
        )
      }
    </div>

    {
      needsMigration && (
        <p role="alert" class="mt-6 text-danger">
          Faltan las tablas de ideas y videos. Aplica las migraciones 0006 y 0007 en Supabase.
        </p>
      )
    }
    {
      error && (
        <p role="alert" class="mt-6 text-danger">
          {errorMessages[error] ?? 'Algo salió mal.'}
        </p>
      )
    }
    {!canEdit && <p class="mt-6 text-muted">Tu rol solo permite ver este proyecto.</p>}
    {prefsReset && <p role="status" class="mt-6 text-ok">Preferencias restablecidas.</p>}
    {bulkOk && <p role="status" class="mt-6 text-ok">{bulkOk}</p>}

    <form
      id="studio-form"
      method="post"
      action="/api/videos/create"
      class="mt-8 grid gap-8 lg:grid-cols-[minmax(0,1fr)_19rem]"
      data-studio-form
    >
      <input type="hidden" name="project_id" value={project.id} />
      <input type="hidden" name="idea_id" value="" data-idea-id />

      <fieldset disabled={!canEdit || needsMigration} class="min-w-0 space-y-12">
        <section>
          <h2 class="text-2xl font-semibold tracking-tight">Cuenta la idea</h2>
          <p class="mt-2 max-w-prose text-muted">
            Escribe la idea general. Si aún no tienes una, pide ideas: la IA conoce el proyecto y lo que ya se hizo.
          </p>

          <label class="sr-only" for="idea">Tu idea</label>
          <textarea
            id="idea"
            name="idea"
            rows="4"
            minlength="5"
            maxlength="2000"
            placeholder="Por ejemplo: mostrar cómo un supervisor detecta un rondín omitido en segundos"
            class="mt-6 min-h-36 w-full resize-y rounded-xl border border-border bg-surface p-4 text-lg leading-relaxed focus-visible:border-focus disabled:opacity-60"
            data-idea-text></textarea>
          <div class="mt-3 flex flex-wrap items-center justify-between gap-3">
            <div class="flex flex-wrap items-center gap-3">
              <button type="button" class={secondary} data-suggest>
                <svg viewBox="0 0 24 24" class="size-5" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                  <path d="M12 3l1.9 5.1L19 10l-5.1 1.9L12 17l-1.9-5.1L5 10l5.1-1.9z" />
                  <path d="M19 16l.7 1.8L21.5 18.5l-1.8.7L19 21l-.7-1.8-1.8-.7 1.8-.7z" />
                </svg>
                <span data-suggest-label>Dame ideas</span>
              </button>
              <p class="text-muted" data-suggest-status aria-live="polite"></p>
            </div>
            <p class="text-sm tabular-nums text-muted" data-idea-count>0 / 2000</p>
          </div>

          <div class="mt-8">
            <div class="inline-flex rounded-xl border border-border bg-surface p-1" role="group" aria-label="Lista de ideas">
              <button
                type="button"
                data-list-tab="suggested"
                aria-pressed={startTab === 'suggested' ? 'true' : 'false'}
                class="h-10 rounded-lg px-4 font-medium text-muted transition-colors aria-pressed:bg-bg aria-pressed:text-text"
              >
                Sugeridas <span class="tabular-nums" data-count="suggested">{suggested.length}</span>
              </button>
              <button
                type="button"
                data-list-tab="history"
                aria-pressed="false"
                class="h-10 rounded-lg px-4 font-medium text-muted transition-colors aria-pressed:bg-bg aria-pressed:text-text"
              >
                Historial <span class="tabular-nums" data-count="history">{history.length}</span>
              </button>
              <button
                type="button"
                data-list-tab="videos"
                aria-pressed={startTab === 'videos' ? 'true' : 'false'}
                class="h-10 rounded-lg px-4 font-medium text-muted transition-colors aria-pressed:bg-bg aria-pressed:text-text"
              >
                Videos <span class="tabular-nums">{videos.length}</span>
              </button>
            </div>

            <div class="mt-4" data-list-panel="suggested" hidden={startTab !== 'suggested'}>
              {
                canEdit && suggested.length > 0 && (
                  <div class="mb-3 flex flex-wrap items-center justify-between gap-x-4 gap-y-1">
                    <p class="max-w-prose text-muted">
                      Marca las ideas que te gusten y crea un video de cada una de una vez.
                    </p>
                    <button type="button" data-pick-all class="h-10 rounded-lg px-3 font-medium text-muted transition-colors hover:text-text">
                      Elegir todas
                    </button>
                  </div>
                )
              }
              <div
                data-bulk
                hidden
                class="sticky top-2 z-10 mb-3 flex flex-wrap items-center gap-x-4 gap-y-2 rounded-xl border border-accent bg-surface p-3"
              >
                <p class="font-medium" data-bulk-count aria-live="polite"></p>
                <label class="flex items-center gap-2 text-muted">
                  Videos por idea
                  <select data-bulk-per class="h-10 rounded-lg border border-border bg-bg px-2 text-text"></select>
                </label>
                <button type="button" data-bulk-run class={`${primary} ml-auto`}>Crear videos</button>
                <p class="w-full text-sm text-muted" data-bulk-status role="status"></p>
              </div>
              <ul class="space-y-3" data-ideas="suggested">
                {suggested.map((i) => <IdeaItem {...i} />)}
              </ul>
              <p class="text-muted" data-empty="suggested" hidden={suggested.length > 0}>
                No hay ideas pendientes. Pulsa “Dame ideas”.
              </p>
            </div>
            <div class="mt-4" data-list-panel="videos" hidden={startTab !== 'videos'}>
              {
                videos.length === 0 ? (
                  <p class="text-muted">Aún no hay videos en este proyecto.</p>
                ) : (
                  <ul class="divide-y divide-border rounded-xl border border-border bg-surface">
                    {videos.map((v) => (
                      <li>
                        <a href={`/projects/${project.id}/videos/${v.id}`} class="flex flex-wrap items-center justify-between gap-x-6 gap-y-1 px-4 py-3 transition-colors hover:bg-bg">
                          <span class="min-w-0 font-medium">
                            {v.title || 'Guion sin título'}
                            {v.parent_video_id && <span class="ml-2 text-sm font-normal text-muted">Variante</span>}
                          </span>
                          <span class="text-sm text-muted">
                            {v.generated_at ? 'Contenidos generados' : v.script_approved ? 'Guion aprobado' : 'Borrador'}
                          </span>
                        </a>
                      </li>
                    ))}
                  </ul>
                )
              }
            </div>
            <div class="mt-4" data-list-panel="history" hidden>
              <p class="mb-3 max-w-prose text-muted">
                Lo que ya se usó o se descartó. La IA no lo repite; si reutilizas una, la modifica para que se sienta
                distinta.
              </p>
              <ul class="space-y-3" data-ideas="history">
                {history.map((i) => <IdeaItem {...i} />)}
              </ul>
              <p class="text-muted" data-empty="history" hidden={history.length > 0}>Aún no hay historial.</p>
            </div>
          </div>
        </section>

        <section class="border-t border-border pt-10">
          <h2 class="text-2xl font-semibold tracking-tight">¿Cuánto dura?</h2>
          <p class="mt-2 max-w-prose text-muted">
            Elige un tiempo o escribe el que necesites. El guion se divide en escenas con el segundo exacto de cada una.
          </p>
          <div class="mt-6">
            <Stepper
              name="seconds"
              label="Duración del video"
              value={DEFAULT_SECONDS}
              min={LIMITS.minSeconds}
              max={LIMITS.maxSeconds}
              step={5}
              unit="segundos"
            />
            <div class="mt-4 flex flex-wrap gap-2" role="group" aria-label="Duraciones comunes">
              {
                PRESET_SECONDS.map((s) => (
                  <button
                    type="button"
                    data-preset={s}
                    aria-pressed={s === DEFAULT_SECONDS ? 'true' : 'false'}
                    class="h-10 rounded-lg border border-border bg-surface px-4 font-medium tabular-nums transition-[background-color,transform] duration-150 ease-out hover:bg-bg active:scale-[0.97] aria-pressed:border-accent"
                  >
                    {s} s
                  </button>
                ))
              }
            </div>
            <p class="mt-4 text-muted" data-words aria-live="polite"></p>
          </div>
        </section>
      </fieldset>

      <aside class="lg:sticky lg:top-6 lg:self-start">
        <div class="rounded-2xl border border-border bg-surface p-5">
          <h2 class="font-semibold">Tu guion</h2>
          <ul class="mt-3 divide-y divide-border">
            <li class="flex items-start justify-between gap-4 py-3">
              <span class="text-muted">Idea</span>
              <span class="line-clamp-2 min-w-0 text-right font-medium" data-sum="idea">Falta escribirla</span>
            </li>
            <li class="flex items-start justify-between gap-4 py-3">
              <span class="text-muted">Duración</span>
              <span class="text-right font-medium" data-sum="duracion">{DEFAULT_SECONDS} segundos</span>
            </li>
          </ul>
          {
            canEdit && (
              <div class="mt-4 hidden lg:block">
                <button type="submit" disabled={needsMigration} class={`${primary} w-full`} data-submit>
                  Escribir guion
                </button>
              </div>
            )
          }
          <p class="mt-3 text-sm text-muted">
            Después del guion eliges los visuales, el formato, la voz y el audio. Escribirlo puede tardar hasta un
            minuto.
          </p>
          {
            hasPrefs && canEdit && (
              <p class="mt-4 border-t border-border pt-4 text-sm text-muted">
                Recordamos tus últimas elecciones (duración, formato, voz y efectos) para que no las repitas.
                <button
                  type="submit"
                  form="prefs-form"
                  class="ml-1 font-medium text-text underline underline-offset-4 transition-opacity duration-150 ease-out hover:opacity-70"
                >
                  Restablecer
                </button>
              </p>
            )
          }
        </div>
      </aside>

      {
        canEdit && (
          <div class="sticky bottom-0 -mx-4 border-t border-border bg-bg px-4 py-3 lg:hidden">
            <button type="submit" disabled={needsMigration} class={`${primary} w-full`} data-submit>
              Escribir guion
            </button>
          </div>
        )
      }
    </form>

    <form id="prefs-form" method="post" action="/api/preferences">
      <input type="hidden" name="project_id" value={project.id} />
    </form>

    <template data-idea-template>
      <IdeaItem />
    </template>
  </main>
</Base>

<script>
  import { BULK_LIMITS, WORDS_PER_SECOND } from '../../../lib/video-plan';

  const root = document.querySelector<HTMLElement>('[data-studio]');

  if (root) {
    const q = <T extends HTMLElement>(selector: string) => root.querySelector<T>(selector)!;
    const all = <T extends HTMLElement>(selector: string) => [...root.querySelectorAll<T>(selector)];
    const projectId = root.dataset.projectId!;

    const ideaText = q<HTMLTextAreaElement>('[data-idea-text]');
    const ideaCount = q('[data-idea-count]');
    const ideaId = q<HTMLInputElement>('[data-idea-id]');
    const seconds = q<HTMLInputElement>('#seconds');
    const suggestButton = q<HTMLButtonElement>('[data-suggest]');
    const suggestLabel = q('[data-suggest-label]');
    const suggestStatus = q('[data-suggest-status]');
    const template = q<HTMLTemplateElement>('[data-idea-template]');
    const lists = { suggested: q('[data-ideas="suggested"]'), history: q('[data-ideas="history"]') };
    const submits = all<HTMLButtonElement>('[data-submit]');
    const needsMigration = submits.length > 0 && submits[0].disabled;

    const STATUS_LABELS: Record<string, string> = { suggested: 'Sugerida', used: 'Usada', discarded: 'Descartada' };

    // ---- Resumen en vivo ----
    const refreshSummary = () => {
      const idea = ideaText.value.trim();
      const ideaReady = idea.length >= 5;
      const total = Number(seconds.value) || 0;

      const ideaSummary = q('[data-sum="idea"]');
      ideaSummary.textContent = ideaReady ? idea : 'Falta escribirla';
      ideaSummary.classList.toggle('text-danger', !ideaReady);
      q('[data-sum="duracion"]').textContent = `${total} segundos`;
      ideaCount.textContent = `${ideaText.value.length} / 2000`;
      q('[data-words]').textContent = `Unas ${Math.round(total * WORDS_PER_SECOND)} palabras de narración.`;

      for (const preset of all<HTMLButtonElement>('[data-preset]')) {
        preset.setAttribute('aria-pressed', String(Number(preset.dataset.preset) === total));
      }
      if (!needsMigration) for (const button of submits) button.disabled = !ideaReady;
    };

    ideaText.addEventListener('input', refreshSummary);
    seconds.addEventListener('input', refreshSummary);
    for (const preset of all<HTMLButtonElement>('[data-preset]')) {
      preset.addEventListener('click', () => {
        seconds.value = preset.dataset.preset!;
        refreshSummary();
      });
    }

    // ---- Lista de ideas: sugeridas / historial ----
    const refreshLists = () => {
      for (const key of ['suggested', 'history'] as const) {
        const total = lists[key].children.length;
        q(`[data-count="${key}"]`).textContent = String(total);
        q(`[data-empty="${key}"]`).hidden = total > 0;
      }
    };

    const listTabs = all<HTMLButtonElement>('[data-list-tab]');
    const showList = (key: string) => {
      for (const tab of listTabs) tab.setAttribute('aria-pressed', String(tab.dataset.listTab === key));
      for (const panel of all('[data-list-panel]')) panel.hidden = panel.dataset.listPanel !== key;
    };
    for (const tab of listTabs) tab.addEventListener('click', () => showList(tab.dataset.listTab!));

    // ---- Ideas ----
    const addIdea = (idea: { id: string; title: string; angle: string; status: string }) => {
      const item = (template.content.cloneNode(true) as DocumentFragment).querySelector<HTMLElement>('[data-idea]')!;
      item.dataset.id = idea.id;
      item.dataset.status = idea.status;
      item.querySelector('[data-idea-title]')!.textContent = idea.title;
      item.querySelector('[data-idea-angle]')!.textContent = idea.angle;
      item.classList.add('panel-in');
      lists.suggested.prepend(item);
      refreshBulk();
    };

    suggestButton.addEventListener('click', async () => {
      suggestButton.disabled = true;
      suggestLabel.textContent = 'Pensando…';
      suggestStatus.textContent = '';
      try {
        const response = await fetch('/api/ideas/suggest', {
          method: 'POST',
          headers: { 'content-type': 'application/json' },
          body: JSON.stringify({ project_id: projectId, direction: ideaText.value }),
        });
        const data = await response.json();
        if (!response.ok) {
          suggestStatus.textContent =
            data.error === 'config'
              ? 'Falta GEMINI_API_KEY en el .env del servidor.'
              : 'No se pudieron generar ideas. Intenta de nuevo.';
          return;
        }
        for (const idea of [...data.ideas].reverse()) addIdea(idea);
        showList('suggested');
        suggestStatus.textContent = data.ideas.length
          ? `${data.ideas.length} ideas nuevas.`
          : 'Todas se parecían al historial. Prueba con otra dirección.';
        refreshLists();
      } catch {
        suggestStatus.textContent = 'No se pudieron generar ideas. Intenta de nuevo.';
      } finally {
        suggestButton.disabled = false;
        suggestLabel.textContent = 'Dame ideas';
      }
    });

    root.addEventListener('click', async (event) => {
      const target = event.target as HTMLElement;
      const item = target.closest<HTMLElement>('[data-idea]');
      if (!item) return;

      if (target.closest('[data-use-idea]')) {
        const title = item.querySelector('[data-idea-title]')!.textContent ?? '';
        const angle = item.querySelector('[data-idea-angle]')!.textContent ?? '';
        ideaText.value = angle ? `${title}. ${angle}` : title;
        ideaId.value = item.dataset.id ?? '';
        for (const other of all('[data-idea]')) other.dataset.selected = String(other === item);
        refreshSummary();
        ideaText.scrollIntoView({ block: 'nearest', behavior: 'smooth' });
        ideaText.focus({ preventScroll: true });
      }

      if (target.closest('[data-discard-idea]')) {
        const response = await fetch('/api/ideas/update', {
          method: 'POST',
          headers: { 'content-type': 'application/json' },
          body: JSON.stringify({ id: item.dataset.id, status: 'discarded' }),
        });
        if (!response.ok) return;
        item.dataset.status = 'discarded';
        item.querySelector('[data-idea-status]')!.textContent = STATUS_LABELS.discarded;
        if (ideaId.value === item.dataset.id) ideaId.value = '';
        const pick = item.querySelector<HTMLInputElement>('[data-pick]');
        if (pick) pick.checked = false;
        lists.history.prepend(item);
        refreshLists();
        refreshBulk();
      }
    });

    // ---- Crear varios videos a la vez ----
    const bulk = root.querySelector<HTMLElement>('[data-bulk]');
    const bulkCount = root.querySelector<HTMLElement>('[data-bulk-count]');
    const bulkPer = root.querySelector<HTMLSelectElement>('[data-bulk-per]');
    const bulkRun = root.querySelector<HTMLButtonElement>('[data-bulk-run]');
    const bulkStatus = root.querySelector<HTMLElement>('[data-bulk-status]');
    const pickAll = root.querySelector<HTMLButtonElement>('[data-pick-all]');

    const picks = () => all<HTMLInputElement>('[data-idea][data-status="suggested"] [data-pick]');
    const refreshBulk = () => {
      if (!bulk || !bulkCount || !bulkPer || !bulkRun) return;
      const list = picks();
      const chosen = list.filter((p) => p.checked);
      for (const pick of list) {
        pick.disabled = !pick.checked && chosen.length >= BULK_LIMITS.ideas;
        pick.closest<HTMLElement>('[data-idea]')!.dataset.picked = String(pick.checked);
      }
      bulk.hidden = chosen.length === 0;
      if (pickAll) pickAll.textContent = chosen.length === list.length && list.length > 0 ? 'Quitar selección' : 'Elegir todas';

      // Cuántos videos por idea caben sin pasar del total.
      const maxPer = Math.max(1, Math.min(BULK_LIMITS.perIdea, Math.floor(BULK_LIMITS.total / Math.max(1, chosen.length))));
      const current = Math.min(Number(bulkPer.value) || 1, maxPer);
      bulkPer.replaceChildren(
        ...Array.from({ length: maxPer }, (_, i) => new Option(String(i + 1), String(i + 1), false, i + 1 === current)),
      );
      const videos = chosen.length * current;
      bulkCount.textContent = `${chosen.length} ${chosen.length === 1 ? 'idea elegida' : 'ideas elegidas'}`;
      bulkRun.textContent = `Crear ${videos} ${videos === 1 ? 'video' : 'videos'}`;
    };

    root.addEventListener('change', (event) => {
      const target = event.target as HTMLElement;
      if (target.matches('[data-pick], [data-bulk-per]')) refreshBulk();
    });
    pickAll?.addEventListener('click', () => {
      const list = picks().slice(0, BULK_LIMITS.ideas);
      const everyChecked = list.every((p) => p.checked);
      for (const pick of picks()) pick.checked = false;
      if (!everyChecked) for (const pick of list) pick.checked = true;
      refreshBulk();
    });

    bulkRun?.addEventListener('click', async () => {
      const chosen = picks().filter((p) => p.checked);
      if (!chosen.length || !bulkStatus) return;
      const data = new FormData();
      data.set('project_id', projectId);
      data.set('seconds', seconds.value);
      data.set('per_idea', bulkPer!.value);
      for (const pick of chosen) data.append('idea_ids', pick.closest<HTMLElement>('[data-idea]')!.dataset.id ?? '');

      const total = chosen.length * Number(bulkPer!.value);
      bulkRun.disabled = true;
      bulkPer!.disabled = true;
      for (const pick of picks()) pick.disabled = true;
      bulkStatus.textContent = `Escribiendo ${total} ${total === 1 ? 'guion' : 'guiones'} y planeando sus visuales. Puede tardar varios minutos: no cierres la página.`;
      try {
        const response = await fetch('/api/videos/bulk', { method: 'POST', body: data });
        // El servidor responde con un redirect a esta misma pantalla, con el resultado en la dirección.
        location.assign(response.url);
      } catch {
        bulkStatus.textContent = 'Se perdió la conexión. Revisa la pestaña Videos por si alcanzaron a crearse.';
        bulkRun.disabled = false;
        bulkPer!.disabled = false;
        refreshBulk();
      }
    });

    // Escribir el guion tarda: se avisa y se evita el doble envío.
    q<HTMLFormElement>('[data-studio-form]').addEventListener('submit', () => {
      for (const button of submits) {
        button.disabled = true;
        button.textContent = 'Escribiendo guion…';
      }
    });

    refreshSummary();
    refreshBulk();
  }
</script>
