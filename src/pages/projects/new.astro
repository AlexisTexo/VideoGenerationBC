---
import Base from '../../layouts/Base.astro';
import AppHeader from '../../components/AppHeader.astro';
import ProjectWizard from '../../components/ProjectWizard.astro';
import { PROJECT_DEFAULTS } from '../../lib/projects';

const { role } = Astro.locals;
if (role !== 'admin' && role !== 'editor') {
  return Astro.redirect('/');
}

const error = Astro.url.searchParams.get('error');
---

<Base title="Nuevo proyecto · VideoGeneratorBC">
  <AppHeader />

  <main class="mx-auto max-w-2xl px-4 py-10">
    <a href="/" class="text-muted transition-colors hover:text-text">← Proyectos</a>
    <h1 class="mt-4 text-3xl font-semibold tracking-tight">Nuevo proyecto</h1>
    <p class="mt-2 text-muted">
      Cuanto más contexto guardes, mejores serán las ideas y los guiones. Solo el nombre es obligatorio, y todo se
      puede editar después.
    </p>

    {
      error && (
        <p role="alert" class="mt-6 text-danger">
          {error === 'invalid'
            ? 'Revisa el nombre y que los colores tengan formato #RRGGBB.'
            : error === 'logo'
              ? 'El logo debe ser PNG, JPG o WebP de máximo 2 MB.'
              : 'No se pudo crear el proyecto.'}
        </p>
      )
    }

    <div class="mt-10">
      <ProjectWizard project={PROJECT_DEFAULTS} />
    </div>
  </main>
</Base>
