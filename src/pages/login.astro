---
import Base from '../layouts/Base.astro';
import LogoMark from '../components/LogoMark.astro';

const sent = Astro.url.searchParams.get('sent') === '1';
const error = Astro.url.searchParams.get('error');

const errors: Record<string, string> = {
  email: 'Escribe un correo válido.',
  auth: 'No pudimos enviar el enlace. Intenta de nuevo.',
};
const errorMessage = error ? (errors[error] ?? errors.auth) : null;
---

<Base title="Entrar · VideoGeneratorBC">
  <main class="grid min-h-dvh place-items-center px-4 py-12">
    <div class="w-full max-w-sm">
      <div class="rise mb-8 flex items-center gap-3" style="--i: 0">
        <LogoMark class="size-9" />
        <span class="text-lg font-semibold tracking-tight">VideoGeneratorBC</span>
      </div>

      <div class="rise rounded-2xl border border-border bg-surface p-6 sm:p-8" style="--i: 1">
        {
          sent ? (
            <div role="status">
              <h1 class="text-2xl font-semibold tracking-tight">Revisa tu correo</h1>
              <p class="mt-3 text-base text-muted">
                Te enviamos un enlace de acceso. Ábrelo en este mismo navegador para entrar.
              </p>
              <a
                href="/login"
                class="mt-6 inline-block font-medium text-link underline underline-offset-4 hover:no-underline"
              >
                Usar otro correo
              </a>
            </div>
          ) : (
            <>
              <h1 class="text-2xl font-semibold tracking-tight">Entrar</h1>
              <p class="mt-3 text-base text-muted">
                Escribe tu correo y te enviamos un enlace de acceso. Sin contraseña.
              </p>

              <form method="post" action="/api/auth/login" class="mt-6 space-y-4" id="login-form">
                <div>
                  <label for="email" class="mb-2 block font-medium">
                    Correo
                  </label>
                  <input
                    id="email"
                    name="email"
                    type="email"
                    inputmode="email"
                    autocomplete="email"
                    required
                    placeholder="tu@correo.com"
                    aria-invalid={errorMessage ? 'true' : undefined}
                    aria-describedby={errorMessage ? 'login-error' : undefined}
                    class="h-12 w-full rounded-lg border border-border bg-bg px-4 text-base placeholder:text-muted/70 focus-visible:border-focus"
                  />
                  {errorMessage && (
                    <p id="login-error" role="alert" class="mt-2 text-danger">
                      {errorMessage}
                    </p>
                  )}
                </div>

                <button
                  type="submit"
                  class="h-12 w-full rounded-lg bg-accent text-base font-semibold text-accent-fg transition-[background-color,transform] hover:bg-accent-hover active:scale-[0.98] disabled:cursor-wait disabled:opacity-60"
                >
                  Enviar enlace de acceso
                </button>
              </form>
            </>
          )
        }
      </div>

      <p class="rise mt-6 text-muted" style="--i: 2">
        ¿Eres aprobador? Usa el mismo correo con el que te invitaron.
      </p>
    </div>
  </main>

  <script>
    const form = document.getElementById('login-form');
    form?.addEventListener('submit', () => {
      const button = form.querySelector('button[type="submit"]');
      if (button instanceof HTMLButtonElement) {
        button.disabled = true;
        button.textContent = 'Enviando…';
      }
    });
  </script>
</Base>
